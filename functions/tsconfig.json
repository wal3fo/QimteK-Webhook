{
    "compilerOptions": {
        "module": "esnext",
        "moduleResolution": "bundler",
        "target": "esnext",
        "lib": [
            "esnext"
        ],
        "strict": true,
        "types": [
            "@cloudflare/workers-types",
            "node"
        ],
        "baseUrl": "..",
        "paths": {
            "@/*": [
                "src/*"
            ]
        },
        "allowImportingTsExtensions": true,
        "noEmit": true
    },
    "include": [
        "**/*.ts",
        "../api/**/*.ts"
    ]
}