{
  "name": "qimtek-hooks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "client:dev": "vite",
    "build:server": "tsc -p api/tsconfig.json",
    "build": "vite build --mode production",
    "start": "node api/dist/server.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "server:dev": "nodemon",
    "dev": "concurrently \"npm run client:dev\" \"npm run server:dev\"",
    "deploy:secrets": "node scripts/prepare-secrets.js && npx wrangler pages secret bulk secrets.json --project-name qimhook",
    "deploy": "npm run build && npm run deploy:secrets && npx wrangler pages deploy dist --project-name qimhook"
  },
  "overrides": {
    "iconv-lite": "^0.6.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.91.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "framer-motion": "^12.29.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.511.0",
    "nodemailer": "^7.0.12",
    "otplib": "^13.1.1",
    "postcss": "^8.5.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.3.0",
    "recharts": "^3.7.0",
    "serverless-http": "^4.0.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "uuid": "^11.0.5",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260129.0",
    "@eslint/js": "^9.25.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^7.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "nodemon": "^3.1.10",
    "tsx": "^4.20.3",
    "typescript-eslint": "^8.30.1",
    "wrangler": "^4.61.1"
  }
}