# ============================================
# QimteK Hooks - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ============================================
# Environment Mode
# ============================================
# Set to 'production' for production, 'development' for local dev
NODE_ENV=development

# ============================================
# Server Configuration
# ============================================
# Port for local development server
PORT=3001

# Base URL for webhook generation (used in webhook URLs)
# For local: http://localhost:3001
# For production: https://your-domain.vercel.app
BASE_URL=https://qimte-k-webhook--incengine.replit.app

# Client URL for CORS and Socket.io connections
# For local: http://localhost:5173
# For production: https://your-domain.vercel.app
CLIENT_URL=https://qimte-k-webhook--incengine.replit.app

# ============================================
# Database Configuration
# ============================================
# Path to SQLite database file (only used locally if no Supabase)
# Default: ./webhook.db
DB_PATH=./webhook.db

# Supabase Configuration (Prioritized if present)
SUPABASE_URL=https://zlatfvynphcbnvoymtcn.supabase.co
SUPABASE_KEY=sb_secret_4a75T2X_qKWy3LCotED45w_tdw_N-86
SUPABASE_ANON_KEY=sb_publishable_rB1qg34YhoaX0L1JShZyYA__TyIsrJH

# ============================================
# Frontend Configuration (Vite)
# ============================================
# API URL for frontend requests
# For local: http://localhost:3001/api
# For production: /api (relative path)
VITE_API_URL=https://qimte-k-webhook--incengine.replit.app/api
