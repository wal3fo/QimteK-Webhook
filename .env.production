# ============================================
# Environment Mode
# ============================================
NODE_ENV=production

# ============================================
# Server Configuration
# ============================================
PORT=3001

BASE_URL=https://qimhook.pages.dev
CLIENT_URL=https://qimhook.pages.dev

# ============================================
# Database (Supabase)
# ============================================
SUPABASE_URL=https://zlatfvynphcbnvoymtcn.supabase.co

# Public (safe for frontend if needed)
SUPABASE_ANON_KEY=your_supabase_anon_key

# Secret (SERVER ONLY - NEVER expose)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================
# PayPal
# ============================================
# Public
