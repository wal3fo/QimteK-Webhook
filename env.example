# ============================================
# QimteK Hooks - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ============================================
# Environment Mode
# ============================================
# Set to 'production' for production, 'development' for local dev
NODE_ENV=development

# ============================================
# Server Configuration
# ============================================
# Port for local development server
PORT=3001

# Base URL for webhook generation (used in webhook URLs)
# For local: http://localhost:3001
# For production: https://your-domain.vercel.app
BASE_URL=http://localhost:3001

# Client URL for CORS and Socket.io connections
# For local: http://localhost:5173
# For production: https://your-domain.vercel.app
CLIENT_URL=http://localhost:5173

# ============================================
# Database Configuration (Local Development)
# ============================================
# Path to SQLite database file (only used locally)
# Default: ./webhook.db
DB_PATH=./webhook.db

# ============================================
# Frontend Configuration (Vite)
# ============================================
# API URL for frontend requests
# For local: http://localhost:3001/api
# For production: /api (relative path)
VITE_API_URL=http://localhost:3001/api

# ============================================
# Notes
# ============================================
# 1. For LOCAL DEVELOPMENT:
#    - Set NODE_ENV=development
#    - Use localhost URLs for BASE_URL, CLIENT_URL, VITE_API_URL
#
# 2. For VERCEL PRODUCTION:
#    - Set NODE_ENV=production (or Vercel sets it automatically)
#    - Set BASE_URL and CLIENT_URL to your Vercel domain
#    - Set VITE_API_URL=/api (relative path)
#
# 3. Environment variables prefixed with VITE_ are exposed to the frontend
#    All other variables are server-side only

# ============================================
# Email Configuration (SMTP)
# ============================================
# Default: If not configured, uses Ethereal (fake email) for testing
# The preview URL will be printed in the console
#
# Example: Gmail (requires App Password: https://myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your.email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="QimteK Support" <your.email@gmail.com>
